@page "/"

<PageTitle>Home</PageTitle>

@inject HttpClient Http

<h3>Create Shorty</h3>

<div>
    <label>Email:</label>
    <input @bind="email" />
</div>

<div>
    <label>URL:</label>
    <input @bind="url" />
</div>

<button @onclick=CreateShortyAsync>Create Shorty</button>

<p>@resultMessage</p>

@code {
    private string email;
    private string url;
    private string resultMessage;

    public async Task CreateShortyAsync()
    {
        var requestData = new
        {
            Email = email,
            Url = url
        };

        var response = await Http.PostAsJsonAsync("api/shorty/create", requestData);

        if (response.IsSuccessStatusCode)
        {
            var responseData = await response.Content.ReadFromJsonAsync<ResponseMessage>();
            resultMessage = responseData?.Message;
        }
        else
        {
            resultMessage = "Error calling API";
        }
    }

    public class ResponseMessage
    {
        public string Message { get; set; }
    }
}
