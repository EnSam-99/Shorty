@page "/redirect"
@rendermode InteractiveServer
@inject NavigationManager Nav

<h3>Redirect Short URL</h3>

<div class="mb-2">
    <label>Short Code:</label>
    <input @bind="shortCode" class="form-control" placeholder="Enter short code" />
</div>

<button class="btn btn-primary mt-2" @onclick="OpenOriginal">Go</button>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-2">@error</div>
}

@code {
    private string shortCode = "";
    private string? error;

    private void OpenOriginal()
    {
        if (string.IsNullOrWhiteSpace(shortCode))
        {
            error = "Please provide short code!";
            return;
        }

        // Normal navigation (same tab)
        Nav.NavigateTo("/" + shortCode, true);
    }
}
