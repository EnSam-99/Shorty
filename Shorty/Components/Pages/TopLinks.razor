@page "/top-links"
@rendermode InteractiveServer
@inject HttpClient Http

<h3>Top Clicked Short Links</h3>

<div class="mb-3">
    <label class="form-label">Enter Your Email</label>
    <input @bind="email" class="form-control" placeholder="example@mail.com" />
</div>

<button class="btn btn-dark" @onclick="ShowAnalitics">Show Analytics</button>

<button class="btn btn-primary m-3" @onclick="LoadLinks">Show Short Link History</button>

<button class="btn btn-secondary" @onclick="Recalculate">Recalculate Scores</button>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success mt-3">@success</div>
}

@if (links is not null && links.Count > 0)
{
    <table class="table table-striped table-bordered mt-4">
        <thead class="table-dark">
            <tr>
                <th>Short Link</th>
                <th>Original URL</th>
                <th>Clicks</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in links)
            {
                <tr>
                    <td>
                        <a href="/@l.ShortUrl" target="_blank">@l.ShortUrl</a>
                    </td>
                    <td>
                        <a href="@l.OriginalUrl" target="_blank">@l.OriginalUrl</a>
                    </td>
                    <td>@l.Clicks</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string email = "";
    private string? error;
    private string? success;
    private List<TopShortLinkDto>? links;

    private async Task LoadLinks()
    {
        error = null;
        success = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            error = "Please enter an email.";
            return;
        }

        try
        {
            links = await Http.GetFromJsonAsync<List<TopShortLinkDto>>
                ($"http://localhost:5211/api/analytics/top/{email}");
        }
        catch
        {
            links = null;
            error = "No records found or API error.";
        }
    }

    private async Task ShowAnalitics()
    {
        error = null;
        success = null;

        try
        {
            links = await Http.GetFromJsonAsync<List<TopShortLinkDto>>("api/analytics/top-performance");
        }
        catch
        {
            links = null;
            error = "No records found or API error.";
        }
    }


    @code {
        private async Task Recalculate()
        {
            error = null;
            success = null;
            try
            {
                var url = "api/analytics/recalculate-scores";
                var response = await Http.PostAsync(url, null);

                if (response.IsSuccessStatusCode)
                {
                    success = "Successfully recalculated";
                    return;
                }
                else
                {
                    links = null;
                    error = "Failed to recalculate scores. API returned an error.";
                }
                }
                catch
                {
                    links = null;
                    error = "No records found or API error.";
                }
            }
    }

    public class TopShortLinkDto
    {
        public string ShortUrl { get; set; } = "";
        public string OriginalUrl { get; set; } = "";
        public int Clicks { get; set; }
    }
}
