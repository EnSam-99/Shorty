@page "/top-links"
@using Shorty.Domain.Models.Response
@rendermode InteractiveServer
@inject HttpClient Http

<h3>Top Clicked Short Links</h3>

<div class="mb-3">
    <label class="form-label">Enter Your Email</label>
    <input @bind="email" class="form-control" placeholder="example@mail.com" />
</div>

<button class="btn btn-primary" @onclick="LoadLinks" disabled="@isBusy">Show Analytics</button>
<button class="btn btn-secondary ms-2" @onclick="RecalculateScores" disabled="@isBusy">
    @if (isBusy)
    {
        <span>Working…</span>
    }
    else
    {

        <span>Recalculate scores</span>
    }
</button>

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success mt-3">@success</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (links is not null && links.Count > 0)
{
    <table class="table table-striped table-bordered mt-4">
        <thead class="table-dark">
            <tr>
                <th>Short Code</th>
                <th>URL</th>
                <th>Score</th>
                <th>Last Clicked Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in links)
            {
                <tr>
                    <td>
                        <a href="/@l.ShortCode" target="_blank">@l.ShortCode</a>
                    </td>
                    <td>
                        <a href="@l.Url" target="_blank">@l.Url</a>
                    </td>
                    <td>@l.Score</td>
                    <td>@l.LastClickedAt</td>
                 
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string email = "";
    private string? error;
    private string? success;
    private bool isBusy;
    private List<TopShortLinkDto>? links;

    private async Task LoadLinks()
    {
        error = success = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            error = "Please enter an email.";
            return;
        }

        try
        {
            isBusy = true;
            links = await Http.GetFromJsonAsync<List<TopShortLinkDto>>($"api/analytics/top/{email}");
        }
        catch (Exception ex)
        {
            links = null;
            error = "No records found or API error.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RecalculateScores()
    {
        error = success = null;

        try
        {
            isBusy = true;           
            var response = await Http.PostAsync("api/analytics/recalculate-score", content: null);
            response.EnsureSuccessStatusCode();

            success = "Scores recalculated.";          
            if (!string.IsNullOrWhiteSpace(email))
                await LoadLinks();
        }
        catch (HttpRequestException httpEx)
        {
            error = $"API error: {httpEx.Message}";
        }
        catch (Exception ex)
        {
            error = "Unexpected error while recalculating scores.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
