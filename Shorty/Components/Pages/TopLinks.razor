@page "/top-links"
@using Shorty.Domain.Models.Response
@rendermode InteractiveServer
@inject HttpClient Http

<h3>Top Clicked Short Links</h3>

<button class="btn btn-primary" @onclick="LoadLinks" disabled="@isBusy">
    @if (isBusy)
    {
        <span>Loading…</span>
    }
    else
    {
        <span>Show Analytics</span>
    }
</button>

<button class="btn btn-secondary ms-2" @onclick="RecalculateScores" disabled="@isBusy">
    @if (isBusy)
    {
        <span>Working…</span>
    }
    else
    {
        <span>Recalculate scores</span>
    }
</button>

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success mt-3">@success</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (links is not null && links.Count > 0)
{
    <table class="table table-striped table-bordered mt-4">
        <thead class="table-dark">
            <tr>
                <th>Short Code</th>
                <th>URL</th>
                <th>Score</th>
                <th>Clicks</th>
                <th>Last Clicked Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in links)
            {
                <tr>
                    <td><a href="/@l.ShortCode" target="_blank">@l.ShortCode</a></td>
                    <td><a href="@l.Url" target="_blank">@l.Url</a></td>
                    <td>@l.Score</td>
                    <td>@l.Clicks</td>
                    <td>@(l.LastClickedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (links is not null && links.Count == 0)
{
    <div class="alert alert-info mt-4">No links found.</div>
}

@code {
    private bool isBusy;
    private string? error;
    private string? success;
    private List<TopShortLinkDto>? links;

    protected override async Task OnInitializedAsync()
    {
        await LoadLinks();
    }

    private async Task LoadLinks()
    {
        error = success = null;

        try
        {
            isBusy = true;
         
            var response = await Http.GetAsync("api/analytics/top-performance/limit=10");

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                error = $"API error {(int)response.StatusCode} ({response.StatusCode}). Body: {body}";
                links = null;
                return;
            }
        
            links = await response.Content.ReadFromJsonAsync<List<TopShortLinkDto>>()
                    ?? new();

            if (links.Count == 0)
            {
                success = "No links found.";
            }
        }
        catch (Exception ex)
        {
            error = $"Unexpected error: {ex.Message}";
            links = null;
        }
        finally
        {
            isBusy = false;
        }
    }


    private async Task RecalculateScores()
    {
        error = success = null;

        try
        {
            isBusy = true;
            var response = await Http.PostAsync("api/analytics/recalculate-score", null);

            if (response.IsSuccessStatusCode)
            {
                success = "Scores recalculated.";
                await LoadLinks();
            }
            else
            {
                error = $"API error {(int)response.StatusCode}: {response.ReasonPhrase}";
            }
        }
        catch (Exception ex)
        {
            error = $"Unexpected error while recalculating scores: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
