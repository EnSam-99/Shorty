@page "/"
@using global::Shorty.Domain.Models.Request
@using global::Shorty.Domain.Models.Response
@inject HttpClient Http
@rendermode InteractiveServer

<h3>Create Shorty</h3>

<div class="mb-3">
    <label for="urlInput" class="form-label">Enter URL:</label>
    <input id="urlInput" class="form-control" @bind="model.Url" />
</div>

<div class="mb-3">
    <label for="emailInput" class="form-label">Your Email:</label>
    <input id="emailInput" class="form-control" @bind="model.Email" />
</div>

<button class="btn btn-primary" @onclick="CreateShorty">Create</button>

@if (!string.IsNullOrEmpty(createdUrl))
{
    <div class="alert alert-success mt-3">
        Short link created:
        <a href="@createdUrl" target="_blank">@createdUrl</a>
    </div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@code {
    private ShortyCreateRequestModel model = new();
    private string? createdUrl;
    private string? errorMessage;

    private async Task CreateShorty()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/shorty", model);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ShortyCreateDto>();
                createdUrl = $"http://localhost:5211/r/{result!.ShortyUrl}";
                errorMessage = null;
            }
            else
            {
                createdUrl = null;
                errorMessage = $"API returned error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            createdUrl = null;
            errorMessage = $"Request failed: {ex.Message}";
        }
    }
}
