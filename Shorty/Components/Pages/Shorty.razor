@page "/"
@rendermode InteractiveServer
@inject HttpClient Http

<h3>Create Shorty</h3>

<div class="mb-2">
    <label class="form-label">Email:</label>
    <input class="form-control" @bind="email" placeholder="Enter email" />
</div>

<div class="mb-3">
    <label class="form-label">URL:</label>
    <input class="form-control" @bind="url" placeholder="Enter URL" />
</div>

<button class="btn btn-primary" @onclick="CreateShortyAsync">Create Short URL</button>

<p class="mt-3">@resultMessage</p>

@code {
    private string email = string.Empty;
    private string url = string.Empty;
    private string resultMessage = string.Empty;

    private async Task CreateShortyAsync()
    {
        try
        {
            var requestData = new { Email = email, Url = url };
            var response = await Http.PostAsJsonAsync("api/shorty", requestData);

            if (response.IsSuccessStatusCode)
            {
                var data = await response.Content.ReadFromJsonAsync<ShortLink>();
                resultMessage = $"✅ Short URL created: {data?.ShortyUrl}";
            }
            else
            {
                resultMessage = $"❌ API error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            resultMessage = $"⚠️ Exception: {ex.Message}";
        }
    }

    // local model միայն UI-ի համար
    public class ShortLink
    {
        public int Id { get; set; }
        public string Url { get; set; } = string.Empty;
        public string ShortyUrl { get; set; } = string.Empty;
        public DateTime CreatedDate { get; set; }
    }
}
