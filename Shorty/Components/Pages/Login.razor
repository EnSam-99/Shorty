@page "/login"
@inject HttpClient Http
@inject NavigationManager Nav

<h3>Login</h3>

<div class="mb-3">
    <input @bind="Username" placeholder="Username" class="form-control" />
</div>
<div class="mb-3">
    <input type="password" @bind="Password" placeholder="Password" class="form-control" />
</div>

<button class="btn btn-success" @onclick="LoginUser">Login</button>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="mt-3 alert @AlertClass">
        @Message
    </div>
}

@code {
    private string Username = "";
    private string Password = "";
    private string Message = "";
    private string AlertClass = "";

    private async Task LoginUser()
    {
        Message = "";
        AlertClass = "";

        var loginDto = new { Username, Password };

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginDto);

            if (response.IsSuccessStatusCode)
            {
                Message = "Login successful!";
                AlertClass = "alert-success";

                // Navigate to the URL shortener page after login
                await Task.Delay(500);
                Nav.NavigateTo("/url");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Message = $"Error: {error}";
                AlertClass = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            Message = $"Unexpected error: {ex.Message}";
            AlertClass = "alert-danger";
        }
    }
}
