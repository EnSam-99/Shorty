@page "/url"
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json

<h3>Shorten URL</h3>

<input placeholder="Enter URL" @bind="OriginalUrl" />
<button @onclick="ShortenUrl">Shorten</button>

<p>@Message</p>

<h4>Your URLs</h4>
<ul>
    @foreach (var url in Urls)
    {
        <li>@url.ShortURL - @url.OriginalURL</li>
    }
</ul>

@code {
    private string OriginalUrl = "";
    private string Message = "";
    private List<UrlDto> Urls = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUrls();
    }

    private async Task ShortenUrl()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "jwt");
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await Http.PostAsJsonAsync("/api/url", new { OriginalUrl });
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<UrlDto>();
            Urls.Add(result!);
            Message = $"Short URL created: {result!.ShortURL}";
        }
        else
        {
            Message = await response.Content.ReadAsStringAsync();
        }
    }

    private async Task LoadUrls()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "jwt");
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        Urls = await Http.GetFromJsonAsync<List<UrlDto>>("/api/url/user/your-user-id") ?? new();
    }

    class UrlDto
    {
        public string ShortURL { get; set; } = "";
        public string OriginalURL { get; set; } = "";
    }
}
