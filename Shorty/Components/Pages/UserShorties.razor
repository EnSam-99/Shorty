@page "/user-shorties"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http

<h3>User Shorties</h3>

<div class="mb-3">
    <input @bind="email" class="form-control" placeholder="Enter user email" />
</div>

<button type="button"
        class="btn btn-primary"
        disabled="@string.IsNullOrWhiteSpace(email)"
        @onclick="LoadShorties">
    Load
</button>

@if (loading)
{
    <p class="mt-3">Loading…</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}
else if (shorties is not null && shorties.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Short URL</th>
                <th>Original URL</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in shorties)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.ShortyUrl</td>
                    <td>@s.OriginalUrl</td>
                    <td>@s.CreatedDate.ToLocalTime()</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (shorties is not null)
{
    <p class="mt-3">No short links found for this user.</p>
}

@code {
    private string email = string.Empty;
    private List<ShortyListDto>? shorties;
    private bool loading;
    private string? error;

    private async Task LoadShorties()
    {
        loading = true;
        error = null;
        shorties = null;
        StateHasChanged();

        try
        {
            var safeEmail = Uri.EscapeDataString(email.Trim());
            shorties = await Http.GetFromJsonAsync<List<ShortyListDto>>(
                $"api/shorty/by-user/{safeEmail}");
        }
        catch (Exception ex)
        {
            error = $"Request failed: {ex.Message}";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    public class ShortyListDto
    {
        public int Id { get; set; }
        public string ShortyUrl { get; set; } = string.Empty;
        public string OriginalUrl { get; set; } = string.Empty;
        public DateTime CreatedDate { get; set; }
    }
}
